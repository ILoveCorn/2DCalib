function R = axang2rotm(axang)
% Octave stand-in for Robotics System Toolbox axang2rotm.
% Stored as .m.in so addpath(genpath(pwd)) cannot see it.
% axang is n-by-4 [ux uy uz theta]. The axis is normalized; theta is the angle.
% One rotation returns 3-by-3; several return 3-by-3-by-n.

  a = double(axang);
  if numel(a) == 4
    a = reshape(a, 1, 4);
  end
  if size(a, 2) ~= 4
    error('axang2rotm: expected an n-by-4 axis-angle matrix');
  end
  n = size(a, 1);
  R = zeros(3, 3, n);
  for i = 1:n
    R(:, :, i) = one_axang(a(i, :));
  end
  if n == 1
    R = R(:, :, 1);
  end
end

function R = one_axang(a)
  u = a(1:3).';
  theta = a(4);
  nrm = norm(u);
  if nrm < eps
    R = eye(3);
    return
  end
  u = u / nrm;
  K = [0 -u(3) u(2); u(3) 0 -u(1); -u(2) u(1) 0];
  R = eye(3) + sin(theta) * K + (1 - cos(theta)) * (K * K);
end
