function axang = rotm2axang(R)
% Octave stand-in for Robotics System Toolbox rotm2axang.
% Stored as .m.in so addpath(genpath(pwd)) cannot see it.
% Returns n-by-4 [ux uy uz theta] with theta in [0, pi].
% A single 3-by-3 matrix returns 1-by-4. The angle is element 4, which is
% all line_RCIM2022 / calibrationError read.

  R = double(R);
  if ndims(R) == 2
    axang = one_rotm(R);
    return
  end
  n = size(R, 3);
  axang = zeros(n, 4);
  for i = 1:n
    axang(i, :) = one_rotm(R(:, :, i));
  end
end

function a = one_rotm(R)
  tr = R(1, 1) + R(2, 2) + R(3, 3);
  cosine = max(-1, min(1, (tr - 1) / 2));
  theta = acos(cosine);
  if theta < 1e-12
    a = [0 0 1 0];
    return
  end
  if pi - theta < 1e-8
    a = axang_half_turn(R, theta);
    return
  end
  v = [R(3, 2) - R(2, 3); R(1, 3) - R(3, 1); R(2, 1) - R(1, 2)];
  u = v / norm(v);
  a = [u.' theta];
end

function a = axang_half_turn(R, theta)
  d = diag(R);
  [~, k] = max(d);
  u = zeros(3, 1);
  u(k) = sqrt(max(0, (R(k, k) + 1) / 2));
  if k == 1
    u(2) = nonzero_sign(R(1, 2) + R(2, 1)) * sqrt(max(0, (R(2, 2) + 1) / 2));
    u(3) = nonzero_sign(R(1, 3) + R(3, 1)) * sqrt(max(0, (R(3, 3) + 1) / 2));
  elseif k == 2
    u(1) = nonzero_sign(R(1, 2) + R(2, 1)) * sqrt(max(0, (R(1, 1) + 1) / 2));
    u(3) = nonzero_sign(R(2, 3) + R(3, 2)) * sqrt(max(0, (R(3, 3) + 1) / 2));
  else
    u(1) = nonzero_sign(R(1, 3) + R(3, 1)) * sqrt(max(0, (R(1, 1) + 1) / 2));
    u(2) = nonzero_sign(R(2, 3) + R(3, 2)) * sqrt(max(0, (R(2, 2) + 1) / 2));
  end
  nrm = norm(u);
  if nrm < eps
    u = [1; 0; 0];
  else
    u = u / nrm;
  end
  a = [u.' theta];
end

function s = nonzero_sign(v)
  s = sign(v);
  if s == 0
    s = 1;
  end
end
